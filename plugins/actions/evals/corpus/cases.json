        "ghRules": [
          {
            "argv": ["api", "repos/octo/synthetic/actions/runs/440/jobs"],
            "stdout": "{\"total_count\":1,\"jobs\":[{\"name\":\"publish\",\"status\":\"completed\",\"conclusion\":\"skipped\"}]}"
          }
        ]
      },
      "scoring": {
        "must": {
