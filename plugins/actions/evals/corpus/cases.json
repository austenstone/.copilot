    {
      "id": "justified-extraction-preserves-contracts",
      "title": "Repeated release jobs justify extraction with contract preservation",
      "skills": ["actions-architecture-review"],
      "prompt": "Assess whether refactoring is warranted and identify relevant behavioral contracts.",
      "evidenceIds": ["SERVICE_A", "SERVICE_B", "SERVICE_C", "REPETITION_FACTS"],
      "fixture": {
        "files": {
          ".github/workflows/service-a.yml": "name: A\non: workflow_dispatch\npermissions:\n  contents: read\n  packages: write\njobs:\n  release:\n    runs-on: ubuntu-latest\n    environment: production\n    outputs:\n      digest: ${{ steps.build.outputs.digest }}\n    steps:\n      - id: build\n        run: echo digest=aaa >> \"$GITHUB_OUTPUT\"\n",
          ".github/workflows/service-b.yml": "name: B\non: workflow_dispatch\npermissions:\n  contents: read\n  packages: write\njobs:\n  release:\n    runs-on: ubuntu-latest\n    environment: production\n    outputs:\n      digest: ${{ steps.build.outputs.digest }}\n    steps:\n      - id: build\n        run: echo digest=bbb >> \"$GITHUB_OUTPUT\"\n",
          ".github/workflows/service-c.yml": "name: C\non: workflow_dispatch\npermissions:\n  contents: read\n  packages: write\njobs:\n  release:\n    runs-on: ubuntu-latest\n    environment: production\n    outputs:\n      digest: ${{ steps.build.outputs.digest }}\n    steps:\n      - id: build\n        run: echo digest=ccc >> \"$GITHUB_OUTPUT\"\n",
          "CASE.md": "The three release jobs have the same permissions, environment gate, output name, secret needs, and control flow. Only the service-specific build command differs.\n"
