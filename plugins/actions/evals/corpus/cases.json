          "abstentions": ["DO_NOT_STOP_AT_FIRST_30_JOBS"]
        },
        "mustNot": {
          "claims": ["ONLY_30_JOBS", "LATEST_ATTEMPT_ONLY_IS_COMPLETE"]
        },
        "allowedClaims": ["JOB_COUNT_42", "THREE_ATTEMPTS_PRESENT", "PAGINATION_REQUIRED", "PRIOR_ATTEMPTS_REQUIRED"],
        "behavior": {
          "expectsChanges": false,
          "preserveClaims": ["PAGINATION_REQUIRED", "PRIOR_ATTEMPTS_REQUIRED"]
        }
      }
    },
