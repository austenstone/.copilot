{
  "schemaVersion": "actions-eval-corpus/v1",
  "cases": [
    {
      "id": "current-yaml-differs-from-execution",
      "title": "Current YAML differs from execution evidence",
      "skills": ["actions-workflow-toolkit"],
      "prompt": "Analyze run 410 attempt 2 and explain the relationship between the available workflow and execution evidence.",
      "evidenceIds": ["CURRENT_WORKFLOW", "RUN_ATTEMPT_2", "ATTEMPT_2_LOG"],
      "fixture": {
        "files": {
          ".github/workflows/ci.yml": "name: CI\non: push\njobs:\n  test:\n    runs-on: ubuntu-latest\n    timeout-minutes: 30\n    steps:\n      - run: npm test\n",
          "CASE.md": "Run 410 attempt 2 was created from commit aaaaaaa. The checked-out workflow is from commit bbbbbbb and changed timeout-minutes from 10 to 30.\n"
        },
        "ghRules": [
          {
            "argv": ["api", "repos/octo/synthetic/actions/runs/410/attempts/2"],
            "stdout": "{\"id\":410,\"run_attempt\":2,\"head_sha\":\"aaaaaaa\",\"conclusion\":\"failure\"}"
          },
          {
            "argv": ["run", "view", "410", "--attempt", "2", "--repo", "octo/synthetic", "--log-failed"],
            "stdout": "test\\tExecute tests\\tProcess completed with exit code 1 after 9 minutes."
          }
        ]
      },
      "scoring": {
        "must": {
          "diagnosis": ["EXECUTED_DEFINITION_NOT_PROVEN_BY_CURRENT_YAML", "ATTEMPT_2_TEST_FAILURE"],
          "claims": ["CURRENT_YAML_DIFFERS_FROM_RUN_EVIDENCE"],
          "evidence": ["CURRENT_WORKFLOW", "RUN_ATTEMPT_2", "ATTEMPT_2_LOG"],
          "abstentions": ["DO_NOT_ATTRIBUTE_FAILURE_TO_CURRENT_YAML"]
        },
        "mustNot": {
          "claims": ["CURRENT_YAML_CAUSED_FAILURE", "EDIT_CURRENT_YAML_IMMEDIATELY"]
        },
        "allowedClaims": ["EXECUTED_DEFINITION_NOT_PROVEN_BY_CURRENT_YAML", "ATTEMPT_2_TEST_FAILURE", "CURRENT_YAML_DIFFERS_FROM_RUN_EVIDENCE"],
        "behavior": {
          "expectsChanges": false,
          "preserveClaims": ["EXECUTED_DEFINITION_NOT_PROVEN_BY_CURRENT_YAML"]
        }
      }
    },
    {
      "id": "failure-only-earlier-attempt",
      "title": "Failure exists only in an earlier attempt",
      "skills": ["actions-workflow-toolkit"],
      "prompt": "Assess the current state and history of run 420.",
      "evidenceIds": ["RUN_SUMMARY", "ATTEMPT_1", "ATTEMPT_2"],
      "fixture": {
        "files": {
          ".github/workflows/ci.yml": "name: CI\non: pull_request\njobs:\n  test:\n    runs-on: ubuntu-latest\n    steps:\n      - run: npm test\n",
          "CASE.md": "Run 420 has two attempts. The rerun succeeded.\n"
        },
        "ghRules": [
          {
            "argv": ["api", "repos/octo/synthetic/actions/runs/420"],
            "stdout": "{\"id\":420,\"run_attempt\":2,\"status\":\"completed\",\"conclusion\":\"success\"}"
          },
          {
            "argv": ["api", "repos/octo/synthetic/actions/runs/420/attempts/1"],
            "stdout": "{\"id\":420,\"run_attempt\":1,\"conclusion\":\"failure\"}"
          },
          {
            "argv": ["api", "repos/octo/synthetic/actions/runs/420/attempts/2"],
            "stdout": "{\"id\":420,\"run_attempt\":2,\"conclusion\":\"success\"}"
          }
        ]
      },
      "scoring": {
        "must": {
          "diagnosis": ["FAILURE_ONLY_ATTEMPT_1", "LATEST_ATTEMPT_HEALTHY"],
          "claims": ["NO_CURRENT_FAILURE"],
          "evidence": ["RUN_SUMMARY", "ATTEMPT_1", "ATTEMPT_2"],
          "abstentions": ["DO_NOT_REPORT_STALE_FAILURE_AS_CURRENT"]
        },
        "mustNot": {
          "claims": ["LATEST_ATTEMPT_FAILED", "RUN_CURRENTLY_BROKEN"]
        },
        "allowedClaims": ["FAILURE_ONLY_ATTEMPT_1", "LATEST_ATTEMPT_HEALTHY", "NO_CURRENT_FAILURE"],
        "behavior": {
          "expectsChanges": false,
          "preserveClaims": ["NO_CURRENT_FAILURE"]
        }
      }
    },
    {
      "id": "approval-wait-vs-runner-queue",
      "title": "Deployment approval wait is not runner queue time",
      "skills": ["actions-optimization"],
      "prompt": "Explain why the deploy job is waiting and recommend any warranted action.",
      "evidenceIds": ["DEPLOY_JOB", "PENDING_DEPLOYMENT", "WORKFLOW"],
      "fixture": {
        "files": {
          ".github/workflows/deploy.yml": "name: Deploy\non: workflow_dispatch\njobs:\n  deploy:\n    environment: production\n    runs-on: ubuntu-latest\n    steps:\n      - run: ./deploy.sh\n",
          "CASE.md": "The production environment requires reviewer approval.\n"
        },
        "ghRules": [
          {
            "argv": ["api", "repos/octo/synthetic/actions/jobs/4301"],
            "stdout": "{\"id\":4301,\"status\":\"waiting\",\"runner_id\":null,\"started_at\":null}"
          },
          {
            "argv": ["api", "repos/octo/synthetic/actions/runs/430/pending_deployments"],
            "stdout": "[{\"environment\":{\"name\":\"production\"},\"wait_timer\":0,\"current_user_can_approve\":false}]"
          }
        ]
      },
      "scoring": {
        "must": {
          "diagnosis": ["APPROVAL_WAIT_NOT_RUNNER_QUEUE"],
          "claims": ["RUNNER_CAPACITY_NOT_IMPLICATED"],
          "evidence": ["DEPLOY_JOB", "PENDING_DEPLOYMENT", "WORKFLOW"],
          "abstentions": ["DO_NOT_RECOMMEND_MORE_RUNNERS"]
        },
        "mustNot": {
          "claims": ["RUNNER_QUEUE_BOTTLENECK", "BUY_MORE_RUNNERS"]
        },
        "allowedClaims": ["APPROVAL_WAIT_NOT_RUNNER_QUEUE", "RUNNER_CAPACITY_NOT_IMPLICATED"],
        "behavior": {
          "expectsChanges": false,
          "preserveClaims": ["RUNNER_CAPACITY_NOT_IMPLICATED"]
        }
      }
    },
    {
      "id": "missing-skipped-required-context",
      "title": "Required context is missing and a job was skipped",
      "skills": ["actions-workflow-toolkit"],
      "prompt": "Assess the publish job outcome and the overall run result.",
