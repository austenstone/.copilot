          "claims": ["SKIP_DOES_NOT_PROVE_PUBLISH_HEALTHY"],
          "evidence": ["WORKFLOW", "RUN_JOBS", "EVENT_PAYLOAD"],
          "abstentions": ["DO_NOT_TREAT_SKIPPED_AS_SUCCESS"]
        },
        "mustNot": {
          "claims": ["PUBLISH_SUCCEEDED", "WORKFLOW_FULLY_VALIDATED"]
        },
        "allowedClaims": ["REQUIRED_CONTEXT_MISSING", "PUBLISH_JOB_SKIPPED", "SKIP_DOES_NOT_PROVE_PUBLISH_HEALTHY"],
        "behavior": {
          "expectsChanges": false,
          "preserveClaims": ["SKIP_DOES_NOT_PROVE_PUBLISH_HEALTHY"]
        }
      }
    },
    {
      "id": "safe-metadata-only-privileged-workflow",
      "title": "Metadata-only privileged workflow is guarded",
      "skills": ["actions-security-review"],
      "prompt": "Review the security posture of the pull_request_target workflow.",
      "evidenceIds": ["WORKFLOW", "ACTION_PIN"],
      "fixture": {
        "files": {
          ".github/workflows/label.yml": "name: Label\non:\n  pull_request_target:\n    types: [opened]\npermissions:\n  contents: read\n  pull-requests: write\njobs:\n  label:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/github-script@60a0d83039c74a4aee543508d2ffcb1c3799cdea\n        with:\n          script: |\n            await github.rest.issues.addLabels({ ...context.repo, issue_number: context.issue.number, labels: ['triage'] })\n",
          "CASE.md": "The workflow does not check out or execute pull-request content. The action reference is a synthetic full commit SHA.\n"
        },
        "ghRules": []
      },
      "scoring": {
        "must": {
          "diagnosis": ["PRIVILEGED_TRIGGER_METADATA_ONLY"],
          "claims": ["NO_UNTRUSTED_CODE_EXECUTION", "CURRENT_GUARDS_ARE_APPROPRIATE"],
          "evidence": ["WORKFLOW", "ACTION_PIN"],
          "abstentions": ["DO_NOT_FLAG_TRIGGER_NAME_ALONE"]
        },
        "mustNot": {
          "claims": ["UNTRUSTED_CODE_EXECUTION", "REPLACE_PULL_REQUEST_TARGET"]
        },
        "allowedClaims": ["PRIVILEGED_TRIGGER_METADATA_ONLY", "NO_UNTRUSTED_CODE_EXECUTION", "CURRENT_GUARDS_ARE_APPROPRIATE"],
        "behavior": {
          "expectsChanges": false,
          "preserveClaims": ["CURRENT_GUARDS_ARE_APPROPRIATE"]
        }
      }
    },
    {
      "id": "scanner-hard-failure",
      "title": "Scanner hard failure is not a clean scan",
      "skills": ["actions-security-review"],
      "prompt": "Interpret the scanner result and recommend next steps.",
      "evidenceIds": ["SCANNER_STDERR", "SCANNER_EXIT"],
      "fixture": {
        "files": {
          ".github/workflows/ci.yml": "name: CI\non: push\njobs:\n  test:\n    runs-on: ubuntu-latest\n    steps:\n      - run: echo ok\n",
          "zizmor.stdout": "",
          "zizmor.stderr": "error: failed to parse .github/workflows/ci.yml; analysis did not complete\n",
          "CASE.md": "Command: zizmor --format json .github/workflows/ci.yml\nExit status: 1\nSee zizmor.stdout and zizmor.stderr for the captured native output.\n"
        },
        "ghRules": []
      },
      "scoring": {
        "must": {
          "diagnosis": ["SCANNER_HARD_FAILURE", "COVERAGE_UNAVAILABLE"],
          "claims": ["SCAN_NOT_CLEAN", "REVIEW_INCOMPLETE"],
          "evidence": ["SCANNER_STDERR", "SCANNER_EXIT"],
          "abstentions": ["DO_NOT_REPORT_NO_FINDINGS"]
        },
        "mustNot": {
          "claims": ["NO_FINDINGS", "WORKFLOWS_SECURE"]
        },
        "allowedClaims": ["SCANNER_HARD_FAILURE", "COVERAGE_UNAVAILABLE", "SCAN_NOT_CLEAN", "REVIEW_INCOMPLETE"],
        "behavior": {
          "expectsChanges": false,
          "preserveClaims": ["REVIEW_INCOMPLETE"]
        }
      }
    },
    {
      "id": "large-run-prior-attempts",
      "title": "Run has more than 30 jobs and prior attempts",
      "skills": ["actions-workflow-toolkit"],
      "prompt": "Assess run 460 and the evidence needed for diagnosis.",
      "evidenceIds": ["RUN", "JOBS_PAGE_1", "JOBS_PAGE_2", "ATTEMPT_1", "ATTEMPT_2", "ATTEMPT_3"],
      "fixture": {
        "files": {
          ".github/workflows/matrix.yml": "name: Matrix\non: push\njobs:\n  test:\n    strategy:\n      matrix:\n        shard: [1, 2, 3, 4, 5, 6, 7]\n        os: [ubuntu-latest, macos-latest, windows-latest, ubuntu-24.04, ubuntu-22.04, macos-15]\n    runs-on: ${{ matrix.os }}\n    steps:\n      - run: echo ${{ matrix.shard }}\n"
        },
        "ghRules": [
          {
            "argv": ["api", "repos/octo/synthetic/actions/runs/460"],
            "stdout": "{\"id\":460,\"run_attempt\":3,\"conclusion\":\"failure\"}"
          },
          {
            "argv": ["api", "repos/octo/synthetic/actions/runs/460/jobs?per_page=30&page=1"],
            "stdout": "{\"total_count\":42,\"jobs\":[{\"id\":1},{\"id\":2},{\"id\":3},{\"id\":4},{\"id\":5},{\"id\":6},{\"id\":7},{\"id\":8},{\"id\":9},{\"id\":10},{\"id\":11},{\"id\":12},{\"id\":13},{\"id\":14},{\"id\":15},{\"id\":16},{\"id\":17},{\"id\":18},{\"id\":19},{\"id\":20},{\"id\":21},{\"id\":22},{\"id\":23},{\"id\":24},{\"id\":25},{\"id\":26},{\"id\":27},{\"id\":28},{\"id\":29},{\"id\":30}]}"
          },
          {
            "argv": ["api", "repos/octo/synthetic/actions/runs/460/jobs?per_page=30&page=2"],
            "stdout": "{\"total_count\":42,\"jobs\":[{\"id\":31},{\"id\":32},{\"id\":33},{\"id\":34},{\"id\":35},{\"id\":36},{\"id\":37},{\"id\":38},{\"id\":39},{\"id\":40},{\"id\":41},{\"id\":42}]}"
          },
          {
            "argv": ["api", "repos/octo/synthetic/actions/runs/460/attempts/1"],
            "stdout": "{\"run_attempt\":1,\"conclusion\":\"failure\"}"
          },
          {
            "argv": ["api", "repos/octo/synthetic/actions/runs/460/attempts/2"],
            "stdout": "{\"run_attempt\":2,\"conclusion\":\"failure\"}"
