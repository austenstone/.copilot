        "allowedClaims": ["EXTRACTION_JUSTIFIED_BY_REPETITION", "PRESERVE_INPUTS", "PRESERVE_SECRETS", "PRESERVE_PERMISSIONS", "PRESERVE_OUTPUTS", "PRESERVE_ENVIRONMENT_GATES"],
        "behavior": {
          "expectsChanges": true,
          "preserveClaims": ["PRESERVE_INPUTS", "PRESERVE_SECRETS", "PRESERVE_PERMISSIONS", "PRESERVE_OUTPUTS", "PRESERVE_ENVIRONMENT_GATES"]
