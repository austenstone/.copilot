#!/usr/bin/env python3
"""Fixture-backed gh stub for collect-run-data tests."""

from __future__ import annotations

import json
import os
import re
import sys
from pathlib import Path
from urllib.parse import parse_qs, urlsplit


def fail(message: str, code: int = 1) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(code)


if sys.argv[1:] == ["--version"]:
    print("gh version 2.80.0 (fixture)")
    raise SystemExit(0)

if len(sys.argv) < 3 or sys.argv[1] != "api":
    fail("unsupported fixture gh invocation")

fixture_dir_value = os.environ.get("GH_FIXTURE_DIR")
if not fixture_dir_value:
    fail("GH_FIXTURE_DIR is required")
fixture_dir = Path(fixture_dir_value)
endpoint = sys.argv[-1]
parsed = urlsplit(endpoint)
path = parsed.path

log_match = re.fullmatch(r"repos/[^/]+/[^/]+/actions/jobs/(\d+)/logs", path)
if log_match:
    statuses = json.loads((fixture_dir / "log-status.json").read_text())
    status = statuses.get(log_match.group(1), "missing")
    if status == "available":
        raise SystemExit(0)
    fail("HTTP 404: Not Found")

attempt_jobs = re.fullmatch(
    r"repos/[^/]+/[^/]+/actions/runs/(\d+)/attempts/(\d+)/jobs", path
)
if attempt_jobs:
    page = int(parse_qs(parsed.query).get("page", ["1"])[0])
    filename = f"attempt-{attempt_jobs.group(2)}-jobs-page-{page}.json"
elif re.fullmatch(
    r"repos/[^/]+/[^/]+/actions/runs/\d+/attempts/(\d+)", path
):
    attempt = re.search(r"/attempts/(\d+)$", path)
    assert attempt is not None
    filename = f"attempt-{attempt.group(1)}.json"
elif re.fullmatch(r"repos/[^/]+/[^/]+/actions/runs/\d+", path):
    filename = "run.json"
else:
    fail(f"unsupported fixture endpoint: {endpoint}")

fixture = fixture_dir / filename
if not fixture.is_file():
    fail(f"HTTP 404: fixture missing: {filename}")
print(fixture.read_text())
